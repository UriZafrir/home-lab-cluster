apiVersion: argoproj.io/v1alpha1
kind: ApplicationSet
metadata:
  name: applicationset-from-slack-1
  namespace: argocd
spec:
  generators:
  - git:
      repoURL: https://github.com/UriZafrir/home-lab-cluster.git
      revision: talos
      files:
      - path: 'applicationset-apps/**/.argocd.yaml'
  template:
    metadata:
      # name: '{{name}}-{{path.basename}}'
      name: '{{path.basename}}'
      finalizers:
      - resources-finalizer.argocd.argoproj.io
    spec:
      project: default # '{{ default "default" .project }}'
      source:
        repoURL: https://github.com/UriZafrir/home-lab-cluster.git
        targetRevision: talos
        path: applicationset-apps/{{path.basename}}
      # destination:
      #   name: '{{name}}'
      #   namespace: '{{values.destination.namespace}}'
      # destination:
      #   server: https://kubernetes.default.svc
      #   namespace: '{{.namespace | default .name}}'
    # spec:
    #   project: '{{ default "default" .project }}'
    #   sources:
    #   - repoURL: '{{source.repoURL}}'
    #     targetRevision: '{{values.clusters.chartRevision | default source.targetRevision}}'
    #     chart: '{{source.chart}}'
    #     path: '{{source.path}}'
    #     helm:
    #       releaseName: '{{path.basename}}'
    #       valueFiles:
    #       - $values/{{path.path}}/values.yaml
    #       - $values/{{path.path}}/values.{{name}}.yaml
      destination:
        # name: '{{name}}'
        server: https://kubernetes.default.svc
        namespace: '{{values.destination.namespace | default .name}}'
      syncPolicy:
        automated:
          prune: true
          selfHeal: true
        syncOptions:
        - CreateNamespace={{values.syncPolicy.syncOptions.CreateNamespace | default "true"}}
        - ServerSideApply={{values.syncPolicy.syncOptions.ServerSideApply | default "false"}} 
