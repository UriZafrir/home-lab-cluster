apiVersion: argoproj.io/v1alpha1
kind: ApplicationSet
metadata:
  name: applicationset-from-slack-1
  namespace: argocd
spec:
  goTemplate: true
  goTemplateOptions: ["missingkey=error"]
  generators:
  - git:
      repoURL: https://github.com/UriZafrir/home-lab-cluster.git
      revision: talos
      files:
      - path: 'applicationset-apps/**/.argocd.yaml'
  template:
    metadata:
      name: '{{.path.basename}}'
      finalizers:
      - resources-finalizer.argocd.argoproj.io
    spec:
      project: default # '{{ default "default" .project }}'
      source:
        repoURL: https://github.com/UriZafrir/home-lab-cluster.git
        targetRevision: talos
        path: applicationset-apps/{{.path.basename}}
      destination:
        server: https://kubernetes.default.svc
        namespace: '{{.destination.namespace}}'
      syncPolicy:
        automated:
          prune: true
          selfHeal: true
        syncOptions:
        - CreateNamespace=true
        - ServerSideApply=true
  templatePatch: |
      {{- if eq .path.basename "argocd" }} 
      spec:
        syncPolicy:
          manual:
            prune: false
            selfHeal: true
      {{-  end }}